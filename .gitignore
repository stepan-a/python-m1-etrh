# Environnement virtuel — reconstructible depuis requirements.lock
.venv/

# Tout ce que le Makefile engendre
build/etudiant/
build/corrige/
notebooks/
content/
dist/
.jupyterlite.doit.db

# Sous-produits Jupyter
.ipynb_checkpoints/
__pycache__/
*.pyc

# Le syllabus n'est pas versionné : il est distribué par les canaux de
# l'université, pas par le dépôt du cours.
syllabus/

# Copie locale de la distribution Pyodide (make lite PYODIDE=local),
# 334 Mo téléchargés une fois et jamais versionnés.
.cache/
